*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
env/
ENV/
.venv/

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# === CONFIGURAÇÕES SENSÍVEIS ===
.env
.env.local
.env.*.local
credentials.json
token.json
*.key
*.pem

# === TEMPLATES (documentos reais do condomínio) ===
templates/*.docx
templates/*.pdf

# === WINDOWS ARTIFACTS ===
nul

# === BANCO DE DADOS ===
data/sentinel.db
data/lumina.db
data/*.db
*.db-journal
*.db-shm
*.db-wal

# === ARQUIVOS GERADOS ===
data/downloads/
data/generated_docs/
data/logs/
data/backups/
*.log

# === FRONTEND ===
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
frontend/.cache/

# Dependencies
#
# `package-lock.json` NÃO é ignorado. Estava, e isso anulava na prática qualquer
# correção de dependência: sem o lock versionado cada `npm install` resolve uma
# árvore própria, e "subimos o Electron para 43" não vale para mais ninguém —
# nem para o CI, que precisa de `npm ci` e só funciona com o lock no repositório.
# Regra geral: biblioteca não versiona lock; APLICAÇÃO que empacota binário, sim.
#
# yarn e pnpm continuam ignorados porque o projeto é npm; um lock de outro
# gerenciador aqui só existiria por engano.
yarn.lock
pnpm-lock.yaml

# === IDEs ===
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# === OS ===
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

